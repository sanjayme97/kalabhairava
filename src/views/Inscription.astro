<script>
  import type { StoneHandle, SpotId } from '../scripts/stone';
  const kn = document.documentElement.lang === 'kn';
  const digits = (n: number) => (kn ? String(n).replace(/\d/g, (d) => '೦೧೨೩೪೫೬೭೮೯'[+d]) : String(n));
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── 3D stone ──
  const canvas = document.querySelector<HTMLCanvasElement>('[data-stone]');
  const viewer = document.querySelector<HTMLElement>('[data-viewer]');
  const ui = document.querySelector<HTMLElement>('[data-ui]');
  const loading = document.querySelector<HTMLElement>('[data-loading]');
  const hint = document.querySelector<HTMLElement>('[data-hint]');
  let stone: StoneHandle | null = null;
  const saveData = (navigator as { connection?: { saveData?: boolean } }).connection?.saveData;

  const boot = async () => {
    if (!canvas || !viewer || saveData) return;
    if (loading) loading.hidden = false;
    const { startStone } = await import('../scripts/stone');
    stone = startStone(canvas, { color: canvas.dataset.color!, normal: canvas.dataset.normal! }, () => {
      viewer.classList.add('is-live');
      if (loading) loading.hidden = true;
      if (ui) ui.hidden = false;
    });
    if (!stone && loading) loading.hidden = true;
  };
  if (canvas) {
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          io.disconnect();
          boot();
        }
      },
      { rootMargin: '200px' },
    );
    io.observe(canvas);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
    b.addEventListener('click', () => {
      const m = b.dataset.mode as 'lamp' | 'turn';
      stone?.setMode(m);
      document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((o) => {
        o.classList.toggle('is-on', o === b);
        o.setAttribute('aria-pressed', String(o === b));
      });
      if (hint) hint.textContent = (m === 'lamp' ? hint.dataset.lamp : hint.dataset.turn) ?? '';
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('[data-spot]').forEach((b) =>
    b.addEventListener('click', () => {
      document.querySelectorAll('[data-spot]').forEach((o) => o.classList.toggle('is-on', o === b));
      if (stone) {
        stone.focus(b.dataset.spot as SpotId);
        canvas?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      }
    }),
  );

  // ── wheel of years: 926 samvatsaras from Vikrama (1100–01) to Parabhava (2026–27) ──
  const wheel = document.querySelector<HTMLElement>('[data-wheel]');
  const hand = wheel?.querySelector<SVGGElement>('[data-hand]');
  const yearsEl = wheel?.querySelector<HTMLElement>('[data-years]');
  const turnsEl = wheel?.querySelector<HTMLElement>('[data-turns]');
  const endEl = wheel?.querySelector<HTMLElement>('[data-end]');
  const replay = wheel?.querySelector<HTMLButtonElement>('[data-replay]');
  const START = 14; // Vikrama
  const STEPS = 926;
  const setAt = (steps: number) => {
    if (!hand || !yearsEl || !turnsEl) return;
    hand.style.transform = `rotate(${(START - 1 + steps) * 6}deg)`;
    yearsEl.textContent = digits(Math.round(steps));
    turnsEl.textContent = digits(Math.floor(steps / 60));
  };
  const spin = () => {
    if (endEl) endEl.hidden = true;
    if (replay) replay.hidden = true;
    const finish = () => {
      setAt(STEPS);
      if (endEl) endEl.hidden = false;
      if (replay) replay.hidden = false;
    };
    if (reduce) return finish();
    const dur = 6000;
    const t0 = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - t0) / dur);
      const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
      setAt(e * STEPS);
      if (t < 1) requestAnimationFrame(step);
      else finish();
    };
    requestAnimationFrame(step);
  };
  if (wheel) {
    setAt(0);
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          io.disconnect();
          spin();
        }
      },
      { threshold: 0.5 },
    );
    io.observe(wheel);
    replay?.addEventListener('click', spin);
  }
</script>

