          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c2 3 2.5 5 0 8-2.5-3-2-5 0-8zM5 15h14l-2 3H7zM9 18v2h6v-2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path></svg>
