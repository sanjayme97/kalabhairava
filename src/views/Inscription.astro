// Which section each line starts, for the guide markers in the text panel.
const sectionStarts = new Map<number, (typeof sections)[number]>();
for (const s of sections) if (!sectionStarts.has(s.from)) sectionStarts.set(s.from, s);

// Spots on the stone, in the order the lamp visits them.
const spotList: [string, string, string][] = [
  ['linga', ...(c.stoneParts[0] as [string, string])],
  ['worshipper', ...(c.stoneParts[1] as [string, string])],
  ['cow', ...(c.stoneParts[2] as [string, string])],
  ['sun', ...(c.stoneParts[3] as [string, string])],
  ['arch', ...(c.stoneParts[4] as [string, string])],
  ['text', c.lettersLabel, c.lettersText],
];

// The 60-year samvatsara wheel. Year 1 (Prabhava) at the top, clockwise.
const R = 120;
const C = 150;
const at = (i: number, r: number) => {
  const a = ((i - 1) * 6 - 90) * (Math.PI / 180);
  return [C + Math.cos(a) * r, C + Math.sin(a) * r];
};
const marks = [
  { i: 1, key: 'prabhava' as const },
  { i: 9, key: 'yuva' as const },
  { i: 14, key: 'vikrama' as const },
  { i: 40, key: 'parabhava' as const },
];
const ticks = Array.from({ length: 60 }, (_, k) => {
  const i = k + 1;
  const long = i % 5 === 1;
  const [x1, y1] = at(i, R - (long ? 12 : 6));
  const [x2, y2] = at(i, R);
  return { x1, y1, x2, y2, long };
});
