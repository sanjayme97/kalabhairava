<Base lang={lang} page="inscription" title={c.title} description={c.description} image="images/shasana-relief.jpg" overlay>
  <section class="viewer night" data-viewer>
    <div class="wrap viewer-head">
      <p class="kicker">{c.eyebrow}</p>
      <h1>{c.h1}</h1>
      <p class="sub">{c.sub}</p>
    </div>

    <div class="wrap intro">
      <dl class="facts">
        {
          c.facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <p class="notice" role="note">{c.notice}</p>
      <p class="intro-summary">{c.overview[1]}</p>
      <nav class="intro-jump" aria-label={c.toc}>
        {c.tocItems.filter(([id]) => id !== 'stone').map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
