---
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
import Kolam from '../components/Kolam.astro';
import { href, type Lang } from '../i18n';
import { temple } from '../data/site';

const { lang } = Astro.props as { lang: Lang };

const c = {
  kn: {
    title: 'ದೇವಾಲಯ',
    description: 'ಮನಕತ್ತೂರಿನ ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಸ್ವಾಮಿ ದೇವಸ್ಥಾನ ಮತ್ತು ಶ್ರೀ ಕಾಲಭೈರವನ ಬಗ್ಗೆ.',
    kicker: 'ಮನಕತ್ತೂರು',
    lede: 'ಮನಕತ್ತೂರು ಊರನ್ನು ಕಾಯುವ ದೇವರ ಸನ್ನಿಧಿ.',
    ch1: 'ಶ್ರೀ ಕಾಲಭೈರವ',
    deity: [
      'ಪುರಾಣಗಳು ಕಾಲಭೈರವನನ್ನು ಶಿವನ ಉಗ್ರ ರೂಪವೆಂದು ಹೇಳುತ್ತವೆ. ಅಹಂಕಾರವನ್ನು ಮುರಿಯಲು ಶಿವನಿಂದಲೇ ಹುಟ್ಟಿದವನು ಭೈರವ.',
      '“ಕಾಲ” ಎಂದರೆ ಸಮಯ. ಸಮಯಕ್ಕೂ ಒಡೆಯನಾದ್ದರಿಂದ ಅವನು ಕಾಲಭೈರವ. ಶಿವನ ಕ್ಷೇತ್ರಗಳನ್ನು ಕಾಯುವ ಕ್ಷೇತ್ರಪಾಲನೂ ಅವನೇ.',
      'ಹಾಸನ, ಮಂಡ್ಯ, ತುಮಕೂರು ಕಡೆಗಳಲ್ಲಿ ಅನೇಕ ಮನೆತನಗಳಿಗೆ ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಮನೆದೇವರು.',
    ],
    form: [
      ['ತ್ರಿಶೂಲ', 'ಶಿವನ ಶಕ್ತಿ.'],
      ['ಡಮರು', 'ಸೃಷ್ಟಿಯ ನಾದ.'],
      ['ಶ್ವಾನ', 'ಭೈರವನ ವಾಹನ. ಎಚ್ಚರ ಮತ್ತು ನಿಷ್ಠೆ.'],
      ['ಕ್ಷೇತ್ರಪಾಲ', 'ಊರನ್ನೂ ಭಕ್ತರನ್ನೂ ಕಾಯುವವನು.'],
    ],
    ch2: 'ನಮ್ಮ ದೇವಸ್ಥಾನ',
    templeBody: [
      'ದೇವಸ್ಥಾನದ ಮುಂಬಾಗಿಲ ಮೇಲಿನ ಗೋಪುರದಲ್ಲಿ ದೇವತೆಗಳ ಬಣ್ಣದ ಶಿಲ್ಪಗಳಿವೆ. ಜಾತ್ರೆಯ ರಾತ್ರಿ ಇಡೀ ಗೋಪುರ ದೀಪಗಳಿಂದ ಬೆಳಗುತ್ತದೆ.',
      'ಹಬ್ಬದ ದಿನಗಳಲ್ಲಿ ಸ್ವಾಮಿಗೆ ಬೆಳ್ಳಿಯ ಪ್ರಭಾವಳಿ ಮತ್ತು ಹೂವಿನ ಅಲಂಕಾರ.',
    ],
    history:
      'ದೇವಸ್ಥಾನದ ಹಳೆಯ ಕಥೆಗಳನ್ನು ಊರಿನ ಹಿರಿಯರಿಂದ ಕೇಳಿ ಇಲ್ಲಿ ಬರೆಯಬೇಕಿದೆ. ನಿಮಗೆ ಗೊತ್ತಿರುವ ಕಥೆ ಅಥವಾ ಹಳೆಯ ಫೋಟೋ ಇದ್ದರೆ ದೇವಸ್ಥಾನ ಸಮಿತಿಗೆ ತಿಳಿಸಿ.',
    ch3: 'ಮನಕತ್ತೂರು',
    village:
      'ಮನಕತ್ತೂರು ಹಾಸನ ಜಿಲ್ಲೆಯ ಅರಸೀಕೆರೆ ತಾಲ್ಲೂಕಿನ ಹಳ್ಳಿ. ಕನಿಷ್ಠ ಒಂಬೈನೂರು ವರ್ಷ ಹಳೆಯ ಊರು. ಕ್ರಿ.ಶ. ೧೧೦೧ರ ಒಂದು ಹೊಯ್ಸಳ ಶಾಸನ “ಮನಗತ್ತೂರು” ಊರನ್ನು ಕಟ್ಟಿದ ಗಾವುಂಡರ ಹೆಸರು ಹೇಳುತ್ತದೆ.',
    insNote: 'ಆ ಶಾಸನ ಕಲ್ಲು ನಮ್ಮ ದೇವಸ್ಥಾನದ ಆವರಣದಲ್ಲಿದೆ. ಆದರೆ ಅದು ಈ ದೇವಾಲಯದ ಕುರಿತದ್ದಲ್ಲ.',
    insLink: 'ಶಾಸನದ ಪುಟ',
  },
  en: {
    title: 'The Temple',
    description: 'About Sri Kalabhairaveshwara Swamy Temple in Manakathuru and the deity Sri Kalabhairava.',
    kicker: 'Manakathuru',
    lede: 'The shrine of the god who watches over Manakathuru.',
    ch1: 'Sri Kalabhairava',
    deity: [
      'The Puranas describe Kalabhairava as the fierce form of Shiva, born from Shiva himself to break pride.',
      'Kāla means time. As master even of time, he is Kalabhairava. He is also the kshetrapala who guards every Shiva shrine.',
      'Around Hassan, Mandya and Tumakuru, many families worship Sri Kalabhairaveshwara as their family deity.',
    ],
    form: [
      ['Trishula', 'The power of Shiva.'],
      ['Damaru', 'The sound of creation.'],
      ['The dog', 'Bhairava’s vehicle. Watchful and loyal.'],
      ['Kshetrapala', 'Guardian of the village and its people.'],
    ],
    ch2: 'Our temple',
    templeBody: [
      'The tower over the temple entrance is covered in painted figures of the gods. On jatra night the whole tower is strung with lights.',
      'On festival days the deity wears the silver prabhavali and a covering of flowers.',
    ],
    history:
      'The old stories of the temple still need to be gathered from the village elders and written down here. If you know one, or have an old photograph, please tell the temple committee.',
    ch3: 'Manakathuru',
    village:
      'Manakathuru is a village in Arsikere Taluk, Hassan District, at least nine hundred years old. A Hoysala inscription of 1101 CE names the gavundas who founded “Managatur”.',
    insNote: 'That inscribed stone stands in our temple courtyard, but it is not about this temple.',
    insLink: 'The inscription page',
  },
}[lang];
---

<Base lang={lang} page="temple" title={c.title} description={c.description} image="images/jatre-night-gopura-2.jpg">
  <header class="page-head">
    <div class="wrap">
      <p class="kicker">{c.kicker}</p>
      <h1>{temple.name[lang]}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap split">
      <div class="prose">
        <p class="chapter"><b>೧</b><span>{c.ch1}</span></p>
        {c.deity.map((p) => <p>{p}</p>)}
        <dl class="list-rule form">
          {
            c.form.map(([t, d]) => (
              <div>
                <dt>{t}</dt>
                <dd>{d}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <Print lang={lang} id="pushpaAlankara" tilt={2} class="split-print" sizes="(min-width: 900px) 22rem, 75vw" />
    </div>
  </section>

  <Kolam dots={7} />

  <section class="section">
    <div class="wrap split split--rev">
      <Print lang={lang} id="nightGopura2" tilt={-2} class="split-print" sizes="(min-width: 900px) 24rem, 80vw" />
      <div class="prose">
        <p class="chapter"><b>೨</b><span>{c.ch2}</span></p>
        {c.templeBody.map((p) => <p>{p}</p>)}
        <p class="ask">{c.history}</p>
      </div>
    </div>
  </section>

  <section class="section night village">
    <div class="wrap split">
      <div class="prose">
        <p class="chapter"><b>೩</b><span>{c.ch3}</span></p>
        <p class="village-text">{c.village}</p>
        <p>{c.insNote}</p>
        <a class="go" href={href(lang, 'inscription')}>{c.insLink}</a>
      </div>
      <Print lang={lang} id="templeNight" tilt={1.5} class="split-print" sizes="(min-width: 900px) 26rem, 85vw" />
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) 0;
  }
  .kicker {
    font-family: var(--display);
    color: var(--kumkum);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  .split {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .split :global(.split-print) {
    max-width: 24rem;
    width: 100%;
    justify-self: center;
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: 1.3fr 1fr;
      gap: 5rem;
    }
    .split--rev {
      grid-template-columns: 1fr 1.3fr;
    }
  }
  .form {
    margin-top: 2rem;
  }
  .form div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1rem;
  }
  .form dt {
    font-family: var(--display);
    font-weight: 800;
    color: var(--kumkum);
  }
  .form dd {
    margin: 0;
    color: var(--ink-soft);
  }
  .ask {
    border-left: 3px solid var(--arishina);
    padding-left: 1rem;
    color: var(--ink-soft);
    font-size: 0.9688rem;
  }
  .village-text {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.6vw, 1.5rem);
    line-height: 1.6;
    color: var(--night-ink) !important;
  }
</style>
