---
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
import { href, type Lang } from '../i18n';
import { photos, photoCategories, galleryOrder, type PhotoCategory } from '../data/site';

const { lang } = Astro.props as { lang: Lang };

const c = {
  kn: {
    title: 'ಚಿತ್ರಸಂಪುಟ',
    description: 'ಮನಕತ್ತೂರು ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಸ್ವಾಮಿ ದೇವಸ್ಥಾನ, ಜಾತ್ರೆ ಮತ್ತು ಶಾಸನ ಕಲ್ಲಿನ ಚಿತ್ರಗಳು.',
    lede: 'ಊರಿನವರು ತೆಗೆದ ಚಿತ್ರಗಳು. ದೊಡ್ಡದಾಗಿ ನೋಡಲು ಚಿತ್ರದ ಮೇಲೆ ಒತ್ತಿ.',
    more: 'ನಿಮ್ಮ ಬಳಿ ಹಳೆಯ ಚಿತ್ರಗಳಿವೆಯೇ?',
    moreBody: 'ಹಳೆಯ ಜಾತ್ರೆಗಳ, ದೇವಸ್ಥಾನದ ಅಥವಾ ಊರಿನ ಹಳೆಯ ಫೋಟೋಗಳಿದ್ದರೆ ದೇವಸ್ಥಾನ ಸಮಿತಿಗೆ ಕೊಡಿ. ಇಲ್ಲಿ ಸೇರಿಸುತ್ತೇವೆ.',
    contact: 'ಸಂಪರ್ಕ',
  },
  en: {
    title: 'Gallery',
    description: 'Photographs of Sri Kalabhairaveshwara Swamy Temple, Manakathuru: the deity, the jatra and the inscription stone.',
    lede: 'Photographs taken by people of the village. Tap a photo to see it larger.',
    more: 'Have old photographs?',
    moreBody: 'If you have photos of past jatras, of the temple or of the old village, please give them to the temple committee and we will add them here.',
    contact: 'Contact',
  },
}[lang];

const order: PhotoCategory[] = ['deity', 'jatre', 'temple', 'inscription'];
const groups = order
  .map((cat) => ({ cat, ids: galleryOrder.filter((id) => photos[id].category === cat) }))
  .filter((g) => g.ids.length);
// A fixed, hand-picked scatter of tilts so the wall looks pinned up, not generated.
const tilts = [-2.2, 1.6, -0.8, 2.4, -1.6, 0.9, -2.6, 1.2, -0.5, 2];
---

<Base lang={lang} page="gallery" title={c.title} description={c.description} image="images/jatre-night-gopura.jpg">
  <header class="section head">
    <div class="wrap">
      <h1>{c.title}</h1>
      <p class="lede">{c.lede}</p>
      <nav class="jump" aria-label={c.title}>
        {groups.map((g) => <a href={`#${g.cat}`}>{photoCategories[g.cat][lang]}</a>)}
      </nav>
    </div>
  </header>

  {
    groups.map((g, gi) => (
      <section id={g.cat} class:list={['section', 'group', { night: g.cat === 'jatre' }]}>
        <div class="wrap">
          <h2>{photoCategories[g.cat][lang]}</h2>
          <div class="wall">
            {g.ids.map((id, i) => (
              <Print lang={lang} id={id} zoom tilt={tilts[(i + gi * 3) % tilts.length]} sizes="(min-width: 1000px) 30vw, (min-width: 640px) 45vw, 90vw" />
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="section">
    <div class="wrap prose">
      <h2>{c.more}</h2>
      <p>{c.moreBody}</p>
      <a class="go" href={href(lang, 'visit')}>{c.contact}</a>
    </div>
  </section>
</Base>

<style>
  .head {
    padding-bottom: 1rem;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
  }
  .jump a {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px dashed currentColor;
  }
  .group {
    scroll-margin-top: 4rem;
  }
  .wall {
    columns: 1;
    column-gap: 2rem;
    margin-top: 2rem;
  }
  .wall :global(.print) {
    break-inside: avoid;
    margin-bottom: 2.25rem;
  }
  @media (min-width: 640px) {
    .wall {
      columns: 2;
    }
  }
  @media (min-width: 1000px) {
    .wall {
      columns: 3;
    }
  }
</style>
