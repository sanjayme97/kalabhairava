---
import Base from '../layouts/Base.astro';
import Print from '../components/Print.astro';
import Kolam from '../components/Kolam.astro';
import { href, asset, type Lang } from '../i18n';
import { temple, timings, festivals, photoCategories } from '../data/site';

const { lang } = Astro.props as { lang: Lang };
const jatre = festivals[0];
const knownTimings = timings.filter((t) => t.time);
const photoCategoriesLabel = lang === 'kn' ? 'ದೀಪೋತ್ಸವದ ಚಿತ್ರಗಳು' : 'Deepotsava photographs';

const c = {
  kn: {
    description: 'ಹಾಸನ ಜಿಲ್ಲೆ, ಅರಸೀಕೆರೆ ತಾಲ್ಲೂಕಿನ ಮನಕತ್ತೂರು ಗ್ರಾಮದ ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಸ್ವಾಮಿ ದೇವಸ್ಥಾನ. ಪೂಜೆ, ಜಾತ್ರೆ ಮತ್ತು ಊರಿನ ಹೊಯ್ಸಳ ಕಾಲದ ಶಾಸನ.',
    bless: 'ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಪ್ರಸನ್ನ',
    title: ['ಶ್ರೀ', 'ಕಾಲಭೈರವೇಶ್ವರ', 'ಸ್ವಾಮಿ'],
    place: 'ಮನಕತ್ತೂರು · ಅರಸೀಕೆರೆ ತಾಲ್ಲೂಕು · ಹಾಸನ ಜಿಲ್ಲೆ',
    hint: 'ಪರದೆಯ ಮೇಲೆ ತಟ್ಟಿ, ನಿಮ್ಮದೊಂದು ದೀಪ ಹಚ್ಚಿ',
    litOne: 'ನಿಮ್ಮ ದೀಪ ಮೆರವಣಿಗೆ ಸೇರಿತು',
    litMany: 'ನೀವು ಹಚ್ಚಿದ {n} ದೀಪಗಳು ಮೆರವಣಿಗೆಯಲ್ಲಿವೆ',
    scroll: 'ಕೆಳಗೆ',
    ch1: 'ದರ್ಶನ',
    h1: 'ಊರು ಕಾಯುವ ದೇವರು',
    p1: [
      'ಕಾಲಭೈರವ ಶಿವನ ಉಗ್ರ ರೂಪ. ಊರನ್ನೂ ಕ್ಷೇತ್ರವನ್ನೂ ಕಾಯುವವನು ಅವನು ಎಂಬುದು ನಮ್ಮ ನಂಬಿಕೆ. ಕೈಯಲ್ಲಿ ತ್ರಿಶೂಲ, ಡಮರು. ಜೊತೆಯಲ್ಲಿ ಶ್ವಾನ.',
      'ಹಬ್ಬದ ದಿನಗಳಲ್ಲಿ ಸ್ವಾಮಿಗೆ ಬೆಳ್ಳಿಯ ಪ್ರಭಾವಳಿ, ಮೈತುಂಬ ಹೂವು.',
    ],
    more1: 'ದೇವಾಲಯದ ಬಗ್ಗೆ',
    ch2: 'ಜಾತ್ರೆ',
    inviteTop: 'ಭಕ್ತಾದಿಗಳಿಗೆ ಆದರದ ಆಹ್ವಾನ',
    h2: 'ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಜಾತ್ರಾ ಮಹೋತ್ಸವ',
    p2: 'ಬಣ್ಣದ ಬಟ್ಟೆ, ಹೂವು, ತೆಂಗಿನಕಾಯಿಗಳಿಂದ ಶೃಂಗರಿಸಿದ ರಥವನ್ನು ಭಕ್ತರು ಎಳೆಯುತ್ತಾರೆ. ಊರಿನವರು, ನೆಂಟರಿಷ್ಟರು ಎಲ್ಲರೂ ಸೇರುವ ವರ್ಷದ ದೊಡ್ಡ ಹಬ್ಬ.',
    chD: 'ಕಾರ್ತೀಕ ದೀಪೋತ್ಸವ',
    hD: 'ದೀಪಗಳ ಮೆರವಣಿಗೆ',
    pD: [
      'ಕಾರ್ತೀಕ ಮಾಸದ ರಾತ್ರಿ ದೇವಸ್ಥಾನ ಸಾವಿರಾರು ದೀಪಗಳಿಂದ ಬೆಳಗುತ್ತದೆ.',
      'ಭಕ್ತರು ಉರಿಯುವ ಆರತಿಯನ್ನು ತಲೆಯ ಮೇಲೆ ಹೊತ್ತು ದೇವಸ್ಥಾನಕ್ಕೆ ಬರುತ್ತಾರೆ. ಊರಿನ ಬೀದಿಯುದ್ದಕ್ಕೂ ದೀಪಗಳ ಸಾಲು.',
    ],
    heroTag: 'ಕಾರ್ತೀಕ ದೀಪೋತ್ಸವದ ರಾತ್ರಿ',
    dateLabel: 'ಈ ವರ್ಷ',
    more2: 'ಪೂಜೆ ಮತ್ತು ಉತ್ಸವಗಳು',
    ch3: 'ಶಾಸನ',
    h3: 'ಕಲ್ಲು ಹೇಳುವ ಕಥೆ',
    facts: [
      ['ದಿನಾಂಕ', 'ಶಕ ೧೦೨೨ · ಕ್ರಿ.ಶ. ೧೧೦೧'],
      ['ಕಾಲ', 'ಹೊಯ್ಸಳ ವಿಷ್ಣುವರ್ಧನ'],
      ['ಊರು ಕಟ್ಟಿದವರು', 'ಚಾಮ-ಗಾವುಂಡ, ಸಂಕ-ಗಾವುಂಡ, ಚಟ್ಟ-ಗಾವುಂಡ'],
      ['ದೇವಾಲಯಗಳು', 'ಮೂಲಸ್ಥಾನ, ಚಾವೇಶ್ವರ, ಚಿಕ್ಕೇಶ್ವರ'],
      ['ಬರೆದವರು', 'ಸೇನಬೋವ ಕಾಳಿಮಯ್ಯ · ಕೆತ್ತಿದವರು ಮಾರೋಜ'],
    ],
    p3: [
      'ದೇವಸ್ಥಾನದ ಆವರಣದಲ್ಲಿ ನಿಂತಿರುವ ಈ ಕಲ್ಲಿನ ಮೇಲೆ ಕ್ರಿ.ಶ. ೧೧೦೧ರ ಬರಹವಿದೆ. ಆಗ ಹೊಯ್ಸಳರ ಕಾಲ.',
      'ಇದು ಈ ದೇವಾಲಯದ ಕುರಿತದ್ದಲ್ಲ. ಆದರೆ “ಮನಗತ್ತೂರು” ಊರನ್ನು ಕಟ್ಟಿದ ಗಾವುಂಡರ ಹೆಸರುಗಳು ಇದರಲ್ಲಿವೆ.',
    ],
    more3: 'ದೀಪ ಹಿಡಿದು ಕಲ್ಲನ್ನು ಓದಿ',
    timingsTitle: 'ದರ್ಶನದ ಸಮಯ',
    visitTitle: 'ಮನಕತ್ತೂರಿಗೆ ಬನ್ನಿ',
    visitMap: 'ನಕ್ಷೆಯಲ್ಲಿ ನೋಡಿ',
    visitMore: 'ದಾರಿ ಮತ್ತು ಸಂಪರ್ಕ',
  },
  en: {
    description: 'Sri Kalabhairaveshwara Swamy Temple, Manakathuru village, Arsikere Taluk, Hassan District: worship, the annual jatra and the village’s Hoysala-era inscription.',
    bless: 'Sri Kalabhairaveshwara Prasanna',
    title: ['Sri', 'Kalabhairaveshwara', 'Swamy'],
    place: 'Manakathuru · Arsikere Taluk · Hassan District',
    hint: 'Tap the screen to light a lamp of your own',
    litOne: 'Your lamp has joined the procession',
    litMany: '{n} of your lamps are in the procession',
    scroll: 'Scroll',
    ch1: 'Darshan',
    h1: 'The god who guards the village',
    p1: [
      'Kalabhairava is the fierce form of Shiva. We believe he watches over the village and this sacred place. He holds the trishula and the damaru, and the dog walks with him.',
      'On festival days he wears the silver prabhavali and is covered in flowers.',
    ],
    more1: 'About the temple',
    ch2: 'Jatra',
    inviteTop: 'All devotees are warmly invited',
    h2: 'Sri Kalabhairaveshwara Jatra Mahotsava',
    p2: 'Devotees pull the chariot, dressed in coloured cloth, flowers and coconuts. The biggest festival of the year, when the whole village and relatives from far away come together.',
    chD: 'Karthika Deepotsava',
    hD: 'The procession of lamps',
    pD: [
      'On Karthika nights the temple is lit with thousands of lamps.',
      'Devotees carry blazing aarati on their heads to the temple, and a line of lamps fills the village street.',
    ],
    heroTag: 'A Karthika Deepotsava night',
    dateLabel: 'This year',
    more2: 'Poojas & festivals',
    ch3: 'Inscription',
    h3: 'What the stone says',
    facts: [
      ['Date', 'Śaka 1022 · 1101 CE'],
      ['Period', 'Hoysala, King Vishnuvardhana'],
      ['Village founded by', 'Chama-gavunda, Sanka-gavunda, Chatta-gavunda'],
      ['Temples named', 'Moolasthana, Chaveshvara, Chikkeshvara'],
      ['Written by', 'Senabova Kalimayya · carved by Maroja'],
    ],
    p3: [
      'The stone standing in the temple courtyard carries writing from 1101 CE, in the time of the Hoysalas.',
      'It is not about this temple. But it names the gavundas who founded the village, then called “Managatur”.',
    ],
    more3: 'Read the stone by lamplight',
    timingsTitle: 'Darshan timings',
    visitTitle: 'Come to Manakathuru',
    visitMap: 'Open the map',
    visitMore: 'Directions & contact',
  },
}[lang];
---

<Base lang={lang} page="" description={c.description} overlay>
  <section class="hero night" data-hero>
    <picture class="hero-bg">
      <source media="(max-width: 700px)" srcset={asset('images/deepotsava-gopura-sm.jpg')} />
      <img src={asset('images/deepotsava-procession.jpg')} alt="" width="1600" height="1200" fetchpriority="high" />
    </picture>
    <div class="hero-veil" aria-hidden="true"></div>
    <canvas class="hero-canvas" data-lamps aria-hidden="true"></canvas>

    <div class="wrap hero-copy">
      <p class="bless">{c.bless}</p>
      <h1>
        <span class="t-sri">{c.title[0]}</span>
        <span class="t-main">{c.title[1]}</span>
        <span class="t-swamy">{c.title[2]}</span>
      </h1>
      <p class="place">{c.place}</p>
    </div>
    <p class="hero-tag">{c.heroTag}</p>
    <p class="hero-hint" data-hint data-one={c.litOne} data-many={c.litMany} hidden aria-live="polite">{c.hint}</p>
    <span class="scroll-cue" aria-hidden="true">{c.scroll}</span>
  </section>

  <section class="section darshan">
    <div class="wrap darshan-grid">
      <div class="darshan-prints">
        <Print lang={lang} id="pushpaAlankara" tilt={-2.5} class="dp-a" sizes="(min-width: 900px) 24rem, 70vw" />
        <Print lang={lang} id="belliPrabhavali" tilt={3} class="dp-b" sizes="(min-width: 900px) 20rem, 55vw" />
      </div>
      <div class="prose">
        <p class="chapter"><b>೧</b><span>{c.ch1}</span></p>
        <h2>{c.h1}</h2>
        {c.p1.map((p) => <p>{p}</p>)}
        <a class="go" href={href(lang, 'temple')}>{c.more1}</a>
      </div>
    </div>
  </section>

  <Kolam dots={9} />

  <section class="section jatre">
    <div class="wrap">
      <p class="chapter"><b>೨</b><span>{c.ch2}</span></p>
      <div class="jatre-grid">
        <div class="invite">
          <span class="invite-mark" aria-hidden="true">
            <svg viewBox="0 0 40 26"><path d="M20 2c4 5 4 11 0 17-4-6-4-12 0-17zM6 10c6 0 11 3 14 9-6 1-12-2-14-9zm28 0c-2 7-8 10-14 9 3-6 8-9 14-9zM6 24h28" fill="currentColor" stroke="currentColor" stroke-width="1"></path></svg>
          </span>
          <p class="invite-top">{c.inviteTop}</p>
          <h2>{c.h2}</h2>
          <p>{c.p2}</p>
          {jatre.date && <p class="invite-date">{c.dateLabel}: <strong>{jatre.date[lang]}</strong></p>}
          <a class="go" href={href(lang, 'poojas')}>{c.more2}</a>
        </div>
        <div class="jatre-prints">
          <Print lang={lang} id="rathaCrowd" tilt={-3} class="jp-1" ratio="4 / 3" caption={false} sizes="(min-width: 900px) 24rem, 70vw" />
          <Print lang={lang} id="rathaBanana" tilt={3} class="jp-2" ratio="3 / 4" focus="50% 30%" caption={false} sizes="(min-width: 900px) 16rem, 45vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="section night deepa">
    <div class="wrap deepa-grid">
      <div class="prose">
        <p class="chapter"><b>೩</b><span>{c.chD}</span></p>
        <h2>{c.hD}</h2>
        {c.pD.map((p) => <p>{p}</p>)}
        <a class="go" href={href(lang, 'gallery') + '#deepotsava'}>{photoCategoriesLabel}</a>
      </div>
      <div class="deepa-prints">
        <Print lang={lang} id="nightGopura" tilt={-2} class="dp-1" ratio="3 / 4" caption={false} sizes="(min-width: 900px) 18rem, 55vw" />
        <Print lang={lang} id="nightAarati" tilt={2.5} class="dp-2" ratio="1 / 1" focus="50% 70%" caption={false} sizes="(min-width: 900px) 16rem, 50vw" />
      </div>
    </div>
  </section>

  <section class="section stone-band">
    <div class="wrap stone-grid">
      <Print lang={lang} id="stoneRelief" tilt={-1.5} caption={false} sizes="(min-width: 900px) 34rem, 92vw" />
      <div class="prose">
        <p class="chapter"><b>೪</b><span>{c.ch3}</span></p>
        <h2>{c.h3}</h2>
        {c.p3.map((p) => <p>{p}</p>)}
        <dl class="list-rule stone-facts">
          {c.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <a class="go" href={href(lang, 'inscription')}>{c.more3}</a>
      </div>
    </div>
  </section>

  <section class="section visit">
    <div class="wrap visit-grid">
      {
        knownTimings.length > 0 && (
          <div>
            <h2>{c.timingsTitle}</h2>
            <dl class="list-rule times">
              {knownTimings.map((t) => (
                <div>
                  <dt>{t.label[lang]}</dt>
                  <dd>{t.time![lang]}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
      <div>
        <h2>{c.visitTitle}</h2>
        <p class="lede">{temple.place[lang]}, {temple.region[lang]}</p>
        <p class="visit-links">
          <a class="go" href={temple.mapUrl} rel="noopener">{c.visitMap}</a>
          <a class="go" href={href(lang, 'visit')}>{c.visitMore}</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  import type { LampsHandle } from '../scripts/lamps';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-lamps]');
  const hint = document.querySelector<HTMLElement>('[data-hint]');
  const saveData = (navigator as { connection?: { saveData?: boolean } }).connection?.saveData;
  let handle: LampsHandle | null = null;

  const start = async () => {
    if (!canvas || !hero || saveData) return;
    const { startLamps } = await import('../scripts/lamps');
    const kn = document.documentElement.lang === 'kn';
    handle = startLamps(canvas, {
      onLight: (n) => {
        if (!hint) return;
        const num = kn ? String(n).replace(/\d/g, (d) => '೦೧೨೩೪೫೬೭೮೯'[+d]) : String(n);
        hint.textContent = n === 1 ? hint.dataset.one! : hint.dataset.many!.replace('{n}', num);
        hint.classList.add('lit');
      },
    });
    if (handle) {
      hero.classList.add('is-live');
      if (hint) hint.hidden = false;
    }
  };
  if ('requestIdleCallback' in window) requestIdleCallback(() => start(), { timeout: 1500 });
  else setTimeout(start, 600);
</script>

<style>
  /* ── hero ── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 50%;
    z-index: -3;
    filter: saturate(1.05) brightness(0.62);
    transform: scale(1.04);
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(120% 70% at 50% 110%, rgb(15 11 9 / 0.2), rgb(15 11 9 / 0.9) 75%),
      linear-gradient(to top, var(--night) 2%, transparent 45%);
  }
  .is-live .hero-bg img {
    filter: saturate(0.85) brightness(0.5) blur(1px);
    transition: filter 1.6s ease;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    touch-action: pan-y;
    cursor: crosshair;
  }
  .hero-copy {
    padding-block: 8rem clamp(6rem, 14vh, 9rem);
    pointer-events: none;
  }
  .bless {
    font-family: var(--display);
    font-weight: 600;
    color: var(--flame) !important;
    font-size: clamp(1rem, 2.2vw, 1.25rem);
    margin-bottom: 0.5rem;
  }
  .hero h1 {
    display: grid;
    margin: 0;
    line-height: 0.98;
    color: #fbefd9;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.6);
  }
  .t-sri,
  .t-swamy {
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    color: var(--flame);
  }
  .t-main {
    font-weight: 800;
    font-size: clamp(3rem, 12.5vw, 9.5rem);
    letter-spacing: -0.02em;
  }
  :lang(en) .t-main {
    font-size: clamp(2.6rem, 9vw, 7rem);
  }
  .t-swamy {
    justify-self: end;
    margin-top: -0.2em;
  }
  .place {
    margin-top: 1.25rem;
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: #e4d3b8 !important;
    letter-spacing: 0.02em;
  }
  .hero-hint {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    margin: 0;
    font-size: 0.875rem;
    color: #f5d8a8 !important;
    background: rgb(15 11 9 / 0.55);
    border: 1px solid rgb(255 154 60 / 0.35);
    padding: 0.35rem 0.8rem;
    pointer-events: none;
    animation: breathe 3.5s ease-in-out infinite;
  }
  .hero-hint.lit {
    animation: none;
    border-color: var(--flame);
  }
  @keyframes breathe {
    50% {
      opacity: 0.55;
    }
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    translate: -50% 0;
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #cdb89a;
    writing-mode: vertical-rl;
    display: none;
  }
  @media (min-width: 900px) {
    .scroll-cue {
      display: block;
    }
  }

  /* ── darshan ── */
  .darshan-grid {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }
  .darshan-prints {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
  }
  .darshan-prints :global(.dp-a) {
    grid-column: 1 / 9;
    grid-row: 1;
    z-index: 1;
  }
  .darshan-prints :global(.dp-b) {
    grid-column: 6 / 13;
    grid-row: 1;
    align-self: end;
    margin-bottom: -2rem;
    z-index: 2;
  }
  @media (min-width: 900px) {
    .darshan-grid {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  /* ── jatre ── */
  .jatre {
    background: var(--paper-2);
  }
  .jatre-grid {
    display: grid;
    gap: 3.5rem;
    align-items: center;
  }
  .invite-top {
    font-family: var(--display);
    color: var(--kumkum);
    font-weight: 600;
  }
  .invite h2 {
    color: var(--kumkum);
  }
  .invite p {
    max-width: 30rem;
    margin-inline: auto;
  }
  .invite-date {
    font-size: 1.125rem;
  }
  .jatre-prints {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-auto-rows: 3.5rem;
  }
  .jatre-prints :global(.jp-1) {
    grid-column: 1 / 6;
    grid-row: 1 / 5;
    z-index: 1;
  }
  .jatre-prints :global(.jp-2) {
    grid-column: 4 / 7;
    grid-row: 3 / 9;
    z-index: 2;
  }
  @media (min-width: 900px) {
    .jatre-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
    }
    .jatre-prints {
      grid-auto-rows: 4.2rem;
    }
  }

  /* ── deepotsava ── */
  .deepa {
    background:
      radial-gradient(50rem 30rem at 80% 50%, rgb(255 154 60 / 0.16), transparent 70%),
      var(--night);
  }
  .deepa h2 {
    color: #fbefd9;
  }
  .deepa-grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
