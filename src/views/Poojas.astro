---
import Base from '../layouts/Base.astro';
import Tbd from '../components/Tbd.astro';
import Photo from '../components/Photo.astro';
import { href, type Lang } from '../i18n';
import { timings, festivals } from '../data/site';

const { lang } = Astro.props as { lang: Lang };

const c = {
  kn: {
    title: 'ಪೂಜೆ ಮತ್ತು ಉತ್ಸವಗಳು',
    description: 'ಮನಕತ್ತೂರು ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಸ್ವಾಮಿ ದೇವಸ್ಥಾನದ ದೈನಂದಿನ ಪೂಜಾ ಸಮಯಗಳು, ಜಾತ್ರೆ ಮತ್ತು ವಿಶೇಷ ದಿನಗಳು.',
    lede: 'ದೈನಂದಿನ ಪೂಜೆ, ತಿಂಗಳ ವಿಶೇಷ ದಿನಗಳು ಮತ್ತು ವರ್ಷದ ಉತ್ಸವಗಳು.',
    daily: 'ದೈನಂದಿನ ಪೂಜಾ ಸಮಯ',
    dailyNote: 'ಹಬ್ಬದ ದಿನಗಳಲ್ಲಿ ಸಮಯ ಬದಲಾಗಬಹುದು.',
    fest: 'ಉತ್ಸವಗಳು ಮತ್ತು ವಿಶೇಷ ದಿನಗಳು',
    thisYear: 'ಈ ವರ್ಷ',
    seva: 'ಸೇವೆಗಳು',
    sevaBody:
      'ಅಭಿಷೇಕ, ಅರ್ಚನೆ, ವಿಶೇಷ ಅಲಂಕಾರ ಮುಂತಾದ ಸೇವೆಗಳ ವಿವರ ಮತ್ತು ಕಾಣಿಕೆ ಮೊತ್ತವನ್ನು ಶೀಘ್ರದಲ್ಲಿ ಇಲ್ಲಿ ಸೇರಿಸಲಾಗುವುದು. ಸೇವೆ ಮಾಡಿಸಲು ದೇವಸ್ಥಾನದ ಅರ್ಚಕರನ್ನು ಅಥವಾ ಸಮಿತಿಯನ್ನು ಸಂಪರ್ಕಿಸಿ.',
    contact: 'ಸಂಪರ್ಕ ಮಾಹಿತಿ',
  },
  en: {
    title: 'Poojas & Festivals',
    description: 'Daily pooja timings, the annual jatra and special days at Sri Kalabhairaveshwara Swamy Temple, Manakathuru.',
    lede: 'Daily worship, the special days of each month and the festivals of the year.',
    daily: 'Daily pooja timings',
    dailyNote: 'Timings may change on festival days.',
    fest: 'Festivals & special days',
    thisYear: 'This year',
    seva: 'Sevas',
    sevaBody:
      'Details of sevas such as abhisheka, archana and special alankara, with offering amounts, will be added here soon. To book a seva, please contact the temple priest or committee.',
    contact: 'Contact details',
  },
}[lang];
---

<Base lang={lang} page="poojas" title={c.title} description={c.description}>
  <header class="page-head">
    <div class="wrap">
      <h1>{c.title}</h1>
      <p class="lede">{c.lede}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap layout">
      <div class="card timings">
        <h2>{c.daily}</h2>
        <table class="table">
          <tbody>
            {
              timings.map((t) => (
                <tr>
                  <th scope="row">{t.label[lang]}</th>
                  <td>{t.time ? t.time[lang] : <Tbd lang={lang} />}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="small">{c.dailyNote}</p>
      </div>

      <div>
        <h2>{c.fest}</h2>
        <ol class="fests">
          {
            festivals.map((f) => (
              <li class:list={['fest', { 'fest--main': f.highlight }]}>
                <h3>{f.name[lang]}</h3>
                <p class="when">{f.when[lang]}</p>
                <p>{f.about[lang]}</p>
                {f.date && (
                  <p class="date">
                    {c.thisYear}: <strong>{f.date[lang]}</strong>
                  </p>
                )}
                {f.highlight && (
                  <div class="fest-photos">
                    <Photo lang={lang} id="rathaBanana" ratio="1 / 1" focus="50% 35%" sizes="(min-width: 900px) 18vw, 45vw" />
                    <Photo lang={lang} id="nightAarati" ratio="1 / 1" focus="50% 60%" sizes="(min-width: 900px) 18vw, 45vw" />
                  </div>
                )}
                {f.highlight && !f.date && (
                  <p class="date">
                    {c.thisYear}: <Tbd lang={lang} />
                  </p>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap prose">
      <h2>{c.seva}</h2>
      <p>{c.sevaBody}</p>
      <a class="btn" href={href(lang, 'visit')}>{c.contact}</a>
    </div>
  </section>
</Base>

<style>
  .layout {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1fr 1.4fr;
      gap: 3.5rem;
    }
    .timings {
      position: sticky;
      top: 6rem;
    }
  }
  .timings h2 {
    font-size: 1.5rem;
  }
  .small {
    font-size: 0.875rem;
    color: var(--ink-soft);
    margin: 1rem 0 0;
  }
  .fests {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .fest {
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--line);
    border-left: 4px solid var(--turmeric);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .fest--main {
    border-left-color: var(--kumkum);
    background: linear-gradient(120deg, color-mix(in srgb, var(--kumkum) 8%, var(--surface)), var(--surface));
  }
  .fest h3 {
    margin-bottom: 0.1em;
  }
  .fest p {
    margin: 0;
  }
  .when {
    color: var(--kumkum);
    font-size: 0.9375rem;
    margin-bottom: 0.4rem !important;
  }
  .fest-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  .fest-photos :global(figcaption) {
    font-size: 0.8125rem;
  }
  .date {
    margin-top: 0.6rem !important;
    font-size: 0.9375rem;
  }
</style>
