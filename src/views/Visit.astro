---
import Base from '../layouts/Base.astro';
import Kolam from '../components/Kolam.astro';
import { type Lang } from '../i18n';
import { temple } from '../data/site';

const { lang } = Astro.props as { lang: Lang };
const k = temple.contact;

const c = {
  kn: {
    title: 'ಭೇಟಿ ಮತ್ತು ಸಂಪರ್ಕ',
    description: 'ಮನಕತ್ತೂರು ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಸ್ವಾಮಿ ದೇವಸ್ಥಾನಕ್ಕೆ ದಾರಿ, ನಕ್ಷೆ, ಭಕ್ತಾದಿಗಳಿಗೆ ಸೂಚನೆಗಳು ಮತ್ತು ಸಂಪರ್ಕ.',
    lede: 'ಮನಕತ್ತೂರಿಗೆ ಬನ್ನಿ.',
    map: 'ಗೂಗಲ್ ನಕ್ಷೆಯಲ್ಲಿ ತೆರೆಯಿರಿ',
    reach: 'ಬರುವ ದಾರಿ',
    reachItems: [
      ['ಹತ್ತಿರದ ಪಟ್ಟಣ', 'ಅರಸೀಕೆರೆ'],
      ['ರೈಲು ನಿಲ್ದಾಣ', 'ಅರಸೀಕೆರೆ ಜಂಕ್ಷನ್'],
      ['ಜಿಲ್ಲಾ ಕೇಂದ್ರ', 'ಹಾಸನ'],
    ],
    notice: 'ಭಕ್ತಾದಿಗಳಿಗೆ ಸೂಚನೆ',
    etiquette: [
      'ಪಾದರಕ್ಷೆಗಳನ್ನು ಹೊರಗೆ ಬಿಡಿ.',
      'ಸಭ್ಯ ಉಡುಪು ಧರಿಸಿ.',
      'ಗರ್ಭಗುಡಿಯ ಫೋಟೋ ತೆಗೆಯುವ ಮೊದಲು ಅರ್ಚಕರನ್ನು ಕೇಳಿ.',
      'ಆವರಣ ಸ್ವಚ್ಛವಾಗಿಡಿ. ಪ್ಲಾಸ್ಟಿಕ್ ಬೇಡ.',
      'ಹಳೆಯ ಶಾಸನ ಕಲ್ಲನ್ನು ಮುಟ್ಟಬೇಡಿ, ಅದಕ್ಕೆ ಏನನ್ನೂ ಹಚ್ಚಬೇಡಿ.',
    ],
    contact: 'ಸಂಪರ್ಕ',
    phone: 'ದೂರವಾಣಿ',
    whatsapp: 'ವಾಟ್ಸ್‌ಆ್ಯಪ್',
    email: 'ಇ-ಮೇಲ್',
    facebook: 'ಫೇಸ್‌ಬುಕ್',
    fbLink: 'ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಮನಕತ್ತೂರು',
  },
  en: {
    title: 'Visit & Contact',
    description: 'How to reach Sri Kalabhairaveshwara Swamy Temple, Manakathuru: map, directions, guidance for devotees and contact.',
    lede: 'Come to Manakathuru.',
    map: 'Open in Google Maps',
    reach: 'Getting here',
    reachItems: [
      ['Nearest town', 'Arsikere'],
      ['Railway station', 'Arsikere Junction'],
      ['District headquarters', 'Hassan'],
    ],
    notice: 'For devotees',
    etiquette: [
      'Please leave footwear outside.',
      'Wear modest clothing.',
      'Ask the priest before photographing the sanctum.',
      'Keep the courtyard clean. No plastic, please.',
      'Please do not touch the old inscription stone or put anything on it.',
    ],
    contact: 'Contact',
    phone: 'Phone',
    whatsapp: 'WhatsApp',
    email: 'Email',
    facebook: 'Facebook',
    fbLink: 'Shri Kalabhairaveshwara Manakathur',
  },
}[lang];

const contacts = [
  k.committee && { label: '', value: k.committee[lang] },
  k.phone && { label: c.phone, value: k.phone, href: `tel:${k.phone.replace(/\s/g, '')}` },
  k.whatsapp && { label: c.whatsapp, value: k.whatsapp, href: `https://wa.me/${k.whatsapp.replace(/\D/g, '')}` },
  k.email && { label: c.email, value: k.email, href: `mailto:${k.email}` },
  { label: c.facebook, value: c.fbLink + ' ↗', href: k.facebook },
].filter(Boolean) as { label: string; value: string; href?: string }[];
---

<Base lang={lang} page="visit" title={c.title} description={c.description} image="images/temple-night-view.jpg">
  <header class="section head">
    <div class="wrap">
      <h1>{c.lede}</h1>
      <address class="address">
        {temple.name[lang]}<br />
        {temple.place[lang]}, {temple.region[lang]}
      </address>
      <p><a class="go" href={temple.mapUrl} rel="noopener">{c.map}</a></p>
      {temple.mapEmbed && <iframe class="map" src={temple.mapEmbed} title={c.map} loading="lazy" referrerpolicy="no-referrer-when-downgrade" />}
    </div>
  </header>

  <Kolam dots={7} />

  <section class="section">
    <div class="wrap cols">
      <div>
        <h2>{c.reach}</h2>
        <dl class="list-rule pairs">
          {c.reachItems.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
        </dl>
      </div>
      <div>
        <h2>{c.contact}</h2>
        <dl class="list-rule pairs">
          {
            contacts.map((x) => (
              <div>
                <dt>{x.label}</dt>
                <dd>{x.href ? <a href={x.href} rel="noopener">{x.value}</a> : x.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="section night">
    <div class="wrap">
      <div class="board">
        <h2>{c.notice}</h2>
        <ol>
          {c.etiquette.map((e) => <li>{e}</li>)}
        </ol>
      </div>
    </div>
  </section>
</Base>

<style>
  .address {
    font-style: normal;
    font-size: clamp(1.1rem, 2.4vw, 1.35rem);
    line-height: 1.7;
    margin: 1rem 0 1.5rem;
    color: var(--ink-soft);
  }
  .map {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 0;
    margin-top: 1.5rem;
  }
  .cols {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 860px) {
    .cols {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }
  .pairs div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .pairs dd {
    margin: 0;
    color: var(--ink-soft);
  }
  /* a painted notice board, like the ones at temple gates */
  .board {
    max-width: 40rem;
    margin: 0 auto;
    border: 2px solid var(--flame);
    outline: 1px solid var(--flame);
    outline-offset: 5px;
    padding: clamp(1.5rem, 5vw, 2.75rem);
  }
  .board h2 {
    color: var(--flame);
    text-align: center;
  }
  .board ol {
    margin: 0;
    padding-left: 1.4rem;
    display: grid;
    gap: 0.6rem;
    color: var(--night-ink);
    font-size: 1.0625rem;
  }
  .board li::marker {
    color: var(--flame);
    font-family: var(--display);
    font-weight: 800;
  }
</style>
