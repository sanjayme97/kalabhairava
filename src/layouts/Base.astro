---
import '../styles/global.css';
import Kolam from '../components/Kolam.astro';
import { nav, pages, href, asset, type Lang, type Page } from '../i18n';
import { temple } from '../data/site';

interface Props {
  lang: Lang;
  page: Page;
  title?: string;
  description: string;
  image?: string;
  /** Header floats over a dark hero. */
  overlay?: boolean;
}

const { lang, page, title, description, image = 'images/deepotsava-gopura.jpg', overlay = false } = Astro.props;
const other: Lang = lang === 'kn' ? 'en' : 'kn';
const fullTitle = title ? `${title} · ${temple.shortName[lang]}, ${temple.place[lang]}` : `${temple.name[lang]} · ${temple.place[lang]}`;
const canonical = new URL(href(lang, page), Astro.site);
const t = {
  kn: { skip: 'ಮುಖ್ಯ ವಿಷಯಕ್ಕೆ ಹೋಗಿ', menu: 'ಮೆನು', close: 'ಮುಚ್ಚಿ', switchTo: 'English', switchLabel: 'Read this page in English' },
  en: { skip: 'Skip to content', menu: 'Menu', close: 'Close', switchTo: 'ಕನ್ನಡ', switchLabel: 'ಈ ಪುಟವನ್ನು ಕನ್ನಡದಲ್ಲಿ ಓದಿ' },
}[lang];
const f = {
  kn: {
    blessing: 'ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಪ್ರಸನ್ನ',
    photos: 'ಇಲ್ಲಿನ ಎಲ್ಲ ಚಿತ್ರಗಳು ಮನಕತ್ತೂರಿನವರೇ ತೆಗೆದವು. ಅನುಮತಿಯಿಲ್ಲದೆ ಬೇರೆಡೆ ಬಳಸಬೇಡಿ.',
    classic: 'ಹಳೆಯ ವಿನ್ಯಾಸ',
  },
  en: {
    blessing: 'Sri Kalabhairaveshwara Prasanna',
    photos: 'Every photograph here was taken in Manakathuru. Please do not reuse them without permission.',
    classic: 'Classic version',
  },
}[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="kn" href={new URL(href('kn', page), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', page), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(href('kn', page), Astro.site)} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0f0b09" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={temple.name[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset(image), Astro.site)} />
    <meta property="og:locale" content={lang === 'kn' ? 'kn_IN' : 'en_IN'} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <header class:list={['site-header', { 'site-header--overlay': overlay }]}>
      <div class="wrap header-row">
        <a class="brand" href={href(lang)}>
          <svg class="brand-mark" viewBox="0 0 40 48" aria-hidden="true">
            <!-- a hand-drawn trishula with a small flame -->
            <path d="M20 46V12M11 7c0 9 3.5 13 9 13s9-4 9-13M20 12l-3.4-5.2L20 2l3.4 4.8z" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M14.5 30.5h11" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
          </svg>
          <span class="brand-text">
            <span class="brand-name">{temple.shortName[lang]}</span>
            <span class="brand-place">{temple.place[lang]}</span>
          </span>
        </a>

        <nav class="desk-nav" aria-label={t.menu}>
          {
            pages.map((p) => (
              <a href={href(lang, p)} aria-current={p === page ? 'page' : undefined}>
                {nav[lang][p]}
              </a>
            ))
          }
        </nav>

        <a class="lang-switch" href={href(other, page)} hreflang={other} lang={other} aria-label={t.switchLabel}>{t.switchTo}</a>

        <details class="menu">
          <summary aria-label={t.menu}>
            <svg viewBox="0 0 28 20" aria-hidden="true"><path d="M2 4c8-1.2 16-.8 24 0M2 10.2c6.5-.7 15-.6 24 .3M2 16.4c9-1 17-.6 24 .2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </summary>
          <nav aria-label={t.menu}>
            <p class="menu-bless">{f.blessing}</p>
            {
              pages.map((p, i) => (
                <a href={href(lang, p)} aria-current={p === page ? 'page' : undefined}>
                  <small>{'೧೨೩೪೫೬'[i]}</small>
                  {nav[lang][p]}
                </a>
              ))
            }
            <a class="menu-lang" href={href(other, page)} hreflang={other} lang={other}>{t.switchTo}</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer night">
      <div class="wrap">
        <Kolam dots={11} class="footer-kolam" />
        <p class="footer-bless">{f.blessing}</p>
        <p class="footer-name">{temple.name[lang]}</p>
        <p class="footer-place">{temple.place[lang]} · {temple.region[lang]}</p>
        <nav class="footer-nav" aria-label="Footer">
          {pages.map((p) => <a href={href(lang, p)}>{nav[lang][p]}</a>)}
        </nav>
        <p class="footer-note">
          {f.photos} · <a href={asset('classic/') + (lang === 'en' ? 'en/' : '')}>{f.classic}</a>
        </p>
      </div>
    </footer>

    <script>
      // Draw each kolam when it scrolls into view.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const kolams = document.querySelectorAll<SVGSVGElement>('[data-kolam]');
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('drawn');
              io.unobserve(e.target);
            }
          },
          { threshold: 0.4 },
        );
        kolams.forEach((k) => {
          k.querySelectorAll('path').forEach((p) => p.style.setProperty('--len', String(Math.ceil(p.getTotalLength()))));
          k.classList.add('will-draw');
          io.observe(k);
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }
  .site-header--overlay {
    position: absolute;
    left: 0;
    right: 0;
    background: linear-gradient(to bottom, rgb(10 6 4 / 0.7), transparent);
    border-bottom: 0;
    color: #f7ecd9;
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }
  .brand-mark {
    width: 1.7rem;
    height: 2.1rem;
    color: var(--kumkum);
    flex: none;
  }
  .site-header--overlay .brand-mark {
    color: var(--flame);
  }
  .brand-text {
    display: grid;
    line-height: 1.5;
    min-width: 0;
  }
  .brand-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /* room for tall Kannada vowel signs (ೀ, ೇ) so they are not clipped */
    padding-top: 0.12em;
  }
  .brand-place {
    font-size: 0.8125rem;
    opacity: 0.75;
  }
  .desk-nav {
    display: none;
    gap: 1.4rem;
  }
  .desk-nav a {
    color: inherit;
    text-decoration: none;
    font-size: 0.9688rem;
    padding-block: 0.3rem;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s ease;
  }
  .desk-nav a:hover,
  .desk-nav a[aria-current='page'] {
    background-size: 100% 2px;
  }
  .desk-nav a[aria-current='page'] {
    color: var(--kumkum);
  }
  .site-header--overlay .desk-nav a[aria-current='page'] {
    color: var(--flame);
  }
  .lang-switch {
    color: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px dashed currentColor;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-right: -0.5rem;
    position: relative;
    z-index: 61;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary svg {
    width: 1.75rem;
    display: block;
  }
  .menu[open] summary {
    color: #f7ecd9;
  }
  .menu nav {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--night);
    color: #f7ecd9;
    padding: 5.5rem 1.5rem 2rem;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    overflow-y: auto;
  }
  .menu-bless {
    font-family: var(--display);
    color: var(--flame);
    margin-bottom: 1.5rem;
  }
  .menu nav a {
    color: inherit;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.9rem;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .menu nav a small {
    font-size: 0.95rem;
    color: var(--flame);
    width: 1.2rem;
  }
  .menu nav a[aria-current='page'] {
    color: var(--flame);
  }
  .menu nav a.menu-lang {
    font-family: var(--body);
    font-weight: 600;
    font-size: 1.1rem;
    border-bottom: 0;
    margin-top: 1.5rem;
    color: var(--flame);
  }
  @media (min-width: 1080px) {
    .desk-nav {
      display: flex;
    }
    .menu {
      display: none;
    }
  }

  .site-footer {
    position: relative;
    padding-block: 4rem 2.5rem;
    text-align: center;
  }
  .footer-kolam {
    color: var(--flame);
    opacity: 0.8;
    margin-bottom: 2rem;
  }
  .footer-bless {
    font-family: var(--display);
    color: var(--flame) !important;
    margin: 0;
  }
  .footer-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    color: var(--night-ink) !important;
    margin: 0.25rem 0;
  }
  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 1.4rem;
    margin: 2rem 0;
  }
  .footer-nav a {
    color: var(--night-ink);
    text-decoration: none;
  }
  .footer-nav a:hover {
    color: var(--flame);
  }
  .footer-note {
    font-size: 0.8125rem;
    opacity: 0.7;
    max-width: 36rem;
    margin-inline: auto;
  }
</style>
