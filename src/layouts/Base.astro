---
import '../styles/global.css';
import Kolam from '../components/Kolam.astro';
import { nav, pages, href, asset, type Lang, type Page } from '../i18n';
import { temple } from '../data/site';
import { keywords, geo, templeJsonLd, websiteJsonLd } from '../data/seo';

interface Props {
  lang: Lang;
  page: Page;
  title?: string;
  description: string;
  image?: string;
  /** Header floats over a dark hero. */
  overlay?: boolean;
  /** Extra schema.org objects for this page. */
  jsonLd?: object[];
}

const { lang, page, title, description, image = 'images/deepotsava-gopura.jpg', overlay = false, jsonLd = [] } = Astro.props;
const other: Lang = lang === 'kn' ? 'en' : 'kn';
// Kannada titles carry the English name too, since many people search in English.
const homeTitle = {
  kn: `${temple.name.kn}, ${temple.place.kn} | Sri Kalabhairaveshwara Temple, Manakathuru`,
  en: 'Sri Kalabhairaveshwara Temple, Manakathuru (Manakathur), Arsikere',
}[lang];
const fullTitle = title ? `${title} · ${temple.shortName[lang]}, ${temple.place[lang]}` : homeTitle;
const siteUrl = new URL(href('kn'), Astro.site).toString();
const imageUrl = new URL(asset(image), Astro.site).toString();
const schemas = [...(page === '' ? [websiteJsonLd(siteUrl)] : []), templeJsonLd(siteUrl, imageUrl), ...jsonLd];
const canonical = new URL(href(lang, page), Astro.site);
const t = {
  kn: { skip: 'ಮುಖ್ಯ ವಿಷಯಕ್ಕೆ ಹೋಗಿ', menu: 'ಮೆನು', close: 'ಮುಚ್ಚಿ', switchTo: 'English', switchLabel: 'Read this page in English' },
  en: { skip: 'Skip to content', menu: 'Menu', close: 'Close', switchTo: 'ಕನ್ನಡ', switchLabel: 'ಈ ಪುಟವನ್ನು ಕನ್ನಡದಲ್ಲಿ ಓದಿ' },
}[lang];
// Bottom bar on phones: the five inner pages, with short labels.
const tabs: { page: Page; label: { kn: string; en: string }; icon: string }[] = [
  { page: 'temple', label: { kn: 'ದೇವಾಲಯ', en: 'Temple' }, icon: 'M4 21h16M6.5 21v-5h11v5M7.5 16l1.2-4h6.6l1.2 4M9.5 12l.8-3.5h3.4l.8 3.5M12 4.5v4M10.6 21v-2.6a1.4 1.4 0 0 1 2.8 0V21' },
  { page: 'poojas', label: { kn: 'ಉತ್ಸವ', en: 'Festivals' }, icon: 'M12 3.5c1.7 2.4 2 4.1 0 6.3-2-2.2-1.7-3.9 0-6.3zM4 13.5h16c-.9 3.6-4 6-8 6s-7.1-2.4-8-6zM12 19.5V21' },
  { page: 'inscription', label: { kn: 'ಶಾಸನ', en: 'Inscription' }, icon: 'M7 20.5V8a5 5 0 0 1 10 0v12.5M5 20.5h14M9.5 9.5h5M9.5 12.5h5M9.5 15.5h3.5' },
  { page: 'gallery', label: { kn: 'ಚಿತ್ರಗಳು', en: 'Photos' }, icon: 'M4 5.5h16v13H4zM4 15.5l4.5-4.5 4 4 2-2 5.5 5.5M15.5 9.5a1.2 1.2 0 1 0 0-.01' },
  { page: 'visit', label: { kn: 'ದಾರಿ', en: 'Visit' }, icon: 'M12 21s-6-6.1-6-10.8a6 6 0 0 1 12 0C18 14.9 12 21 12 21zM12 12.2a2 2 0 1 0 0-4 2 2 0 0 0 0 4z' },
];
// "Add to your phone as an app"
const app = {
  kn: {
    title: 'ಫೋನ್‌ಗೆ ಆ್ಯಪ್ ಆಗಿ ಸೇರಿಸಿ',
    sub: 'ಹೋಮ್ ಸ್ಕ್ರೀನ್‌ನಿಂದ ನೇರ ತೆರೆಯಿರಿ, ಇಂಟರ್ನೆಟ್ ಇಲ್ಲದೆಯೂ',
    add: 'ಸೇರಿಸಿ',
    notNow: 'ಬೇಡ',
    menu: 'ಆ್ಯಪ್ ಆಗಿ ಸೇರಿಸಿ',
    iosTitle: 'ಐಫೋನ್‌ನಲ್ಲಿ ಹೀಗೆ ಸೇರಿಸಿ',
    iosSteps: ['Safari ಯ ಹಂಚು ಗುರುತು (ಬಾಣದ ಗುರುತಿರುವ ಚೌಕ) ಒತ್ತಿ.', '“Add to Home Screen” ಆಯ್ಕೆ ಮಾಡಿ.', 'ಮೇಲೆ “Add” ಒತ್ತಿ.'],
    ok: 'ಸರಿ',
    close: 'ಮುಚ್ಚಿ',
  },
  en: {
    title: 'Add to your phone as an app',
    sub: 'Open it straight from your home screen, even offline',
    add: 'Add',
    notNow: 'Not now',
    menu: 'Add as an app',
    iosTitle: 'To add it on an iPhone',
    iosSteps: ['Tap Safari’s Share button (the square with an arrow).', 'Choose “Add to Home Screen”.', 'Tap “Add” at the top.'],
    ok: 'OK',
    close: 'Close',
  },
}[lang];
const f = {
  kn: {
    blessing: 'ಶ್ರೀ ಕಾಲಭೈರವೇಶ್ವರ ಪ್ರಸನ್ನ',
    write: 'ಇಲ್ಲಿ ಏನಾದರೂ ತಪ್ಪಿದ್ದರೆ, ಅಥವಾ ಸೇರಿಸಬೇಕಾದ ವಿಷಯ ಇದ್ದರೆ ನಮಗೆ ಇಮೇಲ್ ಮಾಡಿ:'
  },
  en: {
    blessing: 'Sri Kalabhairaveshwara Prasanna',
    write: 'Found a mistake, or something we should add? Please email us:'
  },
}[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="kn" href={new URL(href('kn', page), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', page), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(href('kn', page), Astro.site)} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <meta name="google-site-verification" content="4Ucg1zAJ8RPYi7hu4XKRBizkX49NGUf3cxZ4zsPucmA" />
    <!-- Google Analytics: visitor counts, regions and pages -->
    <script is:inline>
      // only on the live site, so local and test copies are never counted
      if (location.hostname === 'kalabhairava.manakathuru.com') {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        var asApp = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;
        gtag('config', 'G-JX9LDJMLXX', { display_mode: asApp ? 'app' : 'browser' });
        var ga = document.createElement('script');
        ga.async = true;
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-JX9LDJMLXX';
        document.head.appendChild(ga);
      }
    </script>
    <meta name="theme-color" content="#0f0b09" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={temple.name[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(asset(image), Astro.site)} />
    <meta property="og:locale" content={lang === 'kn' ? 'kn_IN' : 'en_IN'} />
    <meta property="og:locale:alternate" content={lang === 'kn' ? 'en_IN' : 'kn_IN'} />
    <meta property="og:image:alt" content={temple.name[lang]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="geo.region" content="IN-KA" />
    <meta name="geo.placename" content="Manakathuru, Arsikere, Hassan, Karnataka" />
    <meta name="geo.position" content={`${geo.lat};${geo.lng}`} />
    <meta name="ICBM" content={`${geo.lat}, ${geo.lng}`} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    {schemas.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main" data-nosnippet>{t.skip}</a>

    <header class:list={['site-header', { 'site-header--overlay': overlay }]} data-nosnippet>
      <div class="wrap header-row">
        <a class="brand" href={href(lang)}>
          <svg class="brand-mark" viewBox="10 0 44 64" aria-hidden="true">
            <!-- the same trishula as the favicon, with a kumkum dot on the knob -->
            <g fill="currentColor">
              <path d="M32 1.5c2.6 4.4 5 9.6 5 15 0 4.3-1.8 7.4-3 10.6h-4c-1.2-3.2-3-6.3-3-10.6 0-5.4 2.4-10.6 5-15z"></path>
              <path d="M30.6 33.4c-8.4.2-15.4-2.8-17.6-10.6-1.6-5.6-.8-12.4 1.8-19.4.6 6.2 1.6 12.4 4.6 16.4 2.6 3.4 6.6 4.8 11.2 5z"></path>
              <path d="M33.4 25.8c4.6-.2 8.6-1.6 11.2-5 3-4 4-10.2 4.6-16.4 2.6 7 3.4 13.8 1.8 19.4-2.2 7.8-9.2 10.8-17.6 10.6z"></path>
              <path d="M29.6 25.6h4.8l.6 8.4h-6z"></path>
              <circle cx="32" cy="37.4" r="4.2"></circle>
              <path d="M27 42.4c3.3-.9 6.7-.9 10 0-.2 1-.6 1.6-1.4 2.1-2.4.6-4.8.6-7.2 0-.8-.5-1.2-1.1-1.4-2.1z"></path>
              <path d="M29.8 44.6h4.4l-.5 17.4c-1.1.5-2.3.5-3.4 0z"></path>
            </g>
            <circle class="brand-dot" cx="32" cy="37.4" r="1.7"></circle>
          </svg>
          <span class="brand-text">
            <span class="brand-name">{temple.shortName[lang]}</span>{' '}
            <span class="brand-place">{temple.place[lang]}</span>
          </span>
        </a>

        <nav class="desk-nav" aria-label={t.menu}>
          {
            pages.map((p) => (
              <a href={href(lang, p)} aria-current={p === page ? 'page' : undefined}>
                {nav[lang][p]}
              </a>
            ))
          }
        </nav>

        <a class="lang-switch" href={href(other, page)} hreflang={other} lang={other} aria-label={t.switchLabel}>{t.switchTo}</a>

        <details class="menu">
          <summary aria-label={t.menu}>
            <svg viewBox="0 0 28 20" aria-hidden="true"><path d="M2 4c8-1.2 16-.8 24 0M2 10.2c6.5-.7 15-.6 24 .3M2 16.4c9-1 17-.6 24 .2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          </summary>
          <nav aria-label={t.menu}>
            <p class="menu-bless">{f.blessing}</p>
            {
              pages.map((p, i) => (
                <a href={href(lang, p)} aria-current={p === page ? 'page' : undefined}>
                  <small>{'೧೨೩೪೫೬'[i]}</small>
                  {nav[lang][p]}
                </a>
              ))
            }
            <a class="menu-lang" href={href(other, page)} hreflang={other} lang={other}>{t.switchTo}</a>
            <button type="button" class="menu-app" data-install-open="menu" hidden>{app.menu}</button>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer night">
      <div class="wrap">
        <Kolam dots={11} class="footer-kolam" />
        <p class="footer-bless">{f.blessing}</p>
        <p class="footer-name">{temple.name[lang]}</p>
        <p class="footer-place">{temple.place[lang]} · {temple.region[lang]}</p>
        <nav class="footer-nav" aria-label="Footer" data-nosnippet>
          {pages.map((p) => <a href={href(lang, p)}>{nav[lang][p]}</a>)}
        </nav>
        {
          temple.contact.email && (
            <p class="footer-note">
              {f.write} <a href={`mailto:${temple.contact.email}`}>{temple.contact.email}</a>
            </p>
          )
        }
        <p class="footer-app"><button type="button" data-install-open="footer" hidden>{app.menu}</button></p>
      </div>
    </footer>

    <div class="install" data-install data-nosnippet hidden role="region" aria-label={app.title}>
      <img src={asset('icon-192.png')} alt="" width="44" height="44" />
      <p><b>{app.title}</b><span>{app.sub}</span></p>
      <button type="button" class="install-yes" data-install-yes>{app.add}</button>
      <button type="button" class="install-no" data-install-no aria-label={app.notNow}>{app.notNow}</button>
    </div>
    <div class="ios-sheet" data-ios data-nosnippet hidden role="dialog" aria-label={app.iosTitle}>
      <div>
        <p class="ios-title">{app.iosTitle}</p>
        <ol>{app.iosSteps.map((s) => <li>{s}</li>)}</ol>
        <button type="button" data-ios-close>{app.ok}</button>
      </div>
    </div>
    <dialog class="photo-box" data-photo-box>
      <img alt="" />
      <button type="button" data-photo-close aria-label={app.close}>✕</button>
    </dialog>

    <nav class="tabbar" aria-label={t.menu} data-nosnippet>
      {
        tabs.map((tb) => (
          <a href={href(lang, tb.page)} aria-current={tb.page === page ? 'page' : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={tb.icon} /></svg>
            <span>{tb.label[lang]}</span>
          </a>
        ))
      }
    </nav>

    <script>
      import { trackClicks } from '../scripts/track';
      import { startApp } from '../scripts/app';
      trackClicks();
      startApp();

      // Draw each kolam when it scrolls into view.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const kolams = document.querySelectorAll<SVGSVGElement>('[data-kolam]');
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('drawn');
              io.unobserve(e.target);
            }
          },
          { threshold: 0.4 },
        );
        kolams.forEach((k) => {
          k.querySelectorAll('path').forEach((p) => p.style.setProperty('--len', String(Math.ceil(p.getTotalLength()))));
          k.classList.add('will-draw');
          io.observe(k);
        });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 96%, transparent);
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
  }
  .site-header--overlay {
    position: absolute;
    left: 0;
    right: 0;
    background: linear-gradient(to bottom, rgb(10 6 4 / 0.7), transparent);
    border-bottom: 0;
    color: #f7ecd9;
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }
  .brand-mark {
    width: 1.9rem;
    height: 2.4rem;
    color: var(--ink);
    flex: none;
  }
  .brand-dot {
    fill: var(--kumkum);
  }
  .site-header--overlay .brand-dot {
    fill: #e0674f;
  }
  .site-header--overlay .brand-mark {
    color: #f0c870;
  }
  .brand-text {
    display: grid;
    line-height: 1.5;
    min-width: 0;
  }
  .brand-name {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.15rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    /* room for tall Kannada vowel signs (ೀ, ೇ) so they are not clipped */
    padding-top: 0.12em;
  }
  .brand-place {
    font-size: 0.8125rem;
    opacity: 0.75;
  }
  .desk-nav {
    display: none;
    gap: 1.4rem;
  }
  .desk-nav a {
    color: inherit;
    text-decoration: none;
    font-size: 0.9688rem;
    padding-block: 0.3rem;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.3s ease;
  }
  .desk-nav a:hover,
  .desk-nav a[aria-current='page'] {
    background-size: 100% 2px;
  }
  .desk-nav a[aria-current='page'] {
    color: var(--kumkum);
  }
  .site-header--overlay .desk-nav a[aria-current='page'] {
    color: var(--flame);
  }
  .lang-switch {
    color: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px dashed currentColor;
  }
  .menu summary {
    list-style: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-right: -0.5rem;
    position: relative;
    z-index: 61;
  }
  .menu summary::-webkit-details-marker {
    display: none;
  }
  .menu summary svg {
    width: 1.75rem;
    display: block;
  }
  .menu[open] summary {
    color: #f7ecd9;
  }
  .menu nav {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--night);
    color: #f7ecd9;
    padding: 5.5rem 1.5rem 2rem;
    display: grid;
    align-content: start;
    gap: 0.25rem;
    overflow-y: auto;
  }
  .menu-bless {
    font-family: var(--display);
    color: var(--flame);
    margin-bottom: 1.5rem;
  }
  .menu nav a {
    color: inherit;
    text-decoration: none;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.9rem;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .menu nav a small {
    font-size: 0.95rem;
    color: var(--flame);
    width: 1.2rem;
  }
  .menu nav a[aria-current='page'] {
    color: var(--flame);
  }
  .menu nav a.menu-lang {
    font-family: var(--body);
    font-weight: 600;
    font-size: 1.1rem;
    border-bottom: 0;
    margin-top: 1.5rem;
    color: var(--flame);
  }
  @media (min-width: 1080px) {
    .desk-nav {
      display: flex;
    }
    .menu {
      display: none;
    }
  }

  /* ── bottom bar on phones ── */
  .tabbar {
    display: none;
  }
  @media (max-width: 819px) {
    :global(:root) {
      --tabbar-h: calc(3.9rem + env(safe-area-inset-bottom));
    }
    :global(body) {
      padding-bottom: var(--tabbar-h);
    }
    .tabbar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      /* under the header, so the open menu still covers it */
      z-index: 40;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      height: var(--tabbar-h);
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--paper);
      border-top: 1px solid var(--rule);
      box-shadow: 0 -8px 24px rgb(0 0 0 / 0.1);
    }
    .tabbar a {
      position: relative;
      display: grid;
      place-items: center;
      align-content: center;
      gap: 0.2rem;
      color: var(--ink-soft);
      text-decoration: none;
      font-family: var(--display);
      font-size: 0.78rem;
      font-weight: 600;
      line-height: 1.35;
      -webkit-tap-highlight-color: transparent;
    }
    .tabbar svg {
      width: 1.55rem;
      height: 1.55rem;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .tabbar a[aria-current='page'] {
      color: var(--kumkum);
    }
    .tabbar a[aria-current='page']::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 25%;
      right: 25%;
      height: 3px;
      border-radius: 0 0 3px 3px;
      background: var(--kumkum);
    }
    .tabbar a:active {
      background: var(--paper-2);
    }
    /* out of the way while the full-screen 3D stone is open */
    :global(html.is-locked) .tabbar {
      display: none;
    }
  }

  /* ── add to phone as an app ── */
  .install {
    position: fixed;
    left: 0.75rem;
    right: 0.75rem;
    bottom: calc(var(--tabbar-h, 0px) + 0.75rem);
    z-index: 45;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'icon text yes' 'icon text no';
    align-items: center;
    gap: 0.15rem 0.75rem;
    padding: 0.75rem 0.85rem;
    background: var(--night);
    color: var(--night-ink);
    border: 1px solid rgb(255 154 60 / 0.45);
    box-shadow: 0 10px 34px rgb(0 0 0 / 0.45);
    animation: install-in 0.5s ease both;
  }
  .install[hidden],
  .ios-sheet[hidden] {
    display: none;
  }
  @keyframes install-in {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }
  @media (min-width: 820px) {
    .install {
      left: auto;
      right: 1.25rem;
      bottom: 1.25rem;
      width: 26rem;
    }
  }
  .install img {
    grid-area: icon;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.6rem;
  }
  .install p {
    grid-area: text;
    display: grid;
    margin: 0;
