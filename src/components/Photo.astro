---
import { asset, type Lang } from '../i18n';
import { photos } from '../data/site';
interface Props { lang: Lang; index: number; arch?: boolean; eager?: boolean; caption?: boolean }
const { lang, index, arch = false, eager = false, caption = true } = Astro.props;
const p = photos[index];
---
<figure class:list={['photo', { 'photo--arch': arch }]}>
  <div class="photo-frame">
    <img src={asset(p.src)} width={p.w} height={p.h} alt={p.alt[lang]} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
  {caption && <figcaption>{p.caption[lang]}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
  }
  .photo-frame {
    padding: 8px;
    background: linear-gradient(145deg, var(--turmeric), color-mix(in srgb, var(--turmeric) 55%, var(--kumkum)));
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .photo-frame img {
    width: 100%;
    border-radius: calc(var(--radius) - 6px);
    background: var(--stone);
  }
  .photo--arch .photo-frame,
  .photo--arch .photo-frame img {
    border-radius: 50% 50% var(--radius) var(--radius) / 26% 26% var(--radius) var(--radius);
  }
  .photo--arch .photo-frame img {
    aspect-ratio: 372 / 700;
    object-fit: cover;
    object-position: 50% 30%;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-align: center;
  }
</style>
